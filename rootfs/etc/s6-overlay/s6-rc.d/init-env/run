#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# SCS Forge (self-hosted): 構成タブの additional_path / env_vars を
#   /etc/environment（SSH: pam_env が読む）と /etc/scs-env.sh（統合ターミナル:
#   code-server/run が source）の両方へ反映する。base PATH は固定の末尾。
# ==============================================================================
readonly STANDARD_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
readonly ENV_FILE=/etc/environment
readonly SH_FILE=/etc/scs-env.sh

# additional_path（各項＝絶対パス・schema検証済み）を先頭に連結
prefix=""
if bashio::config.has_value 'additional_path'; then
    while read -r dir; do
        [ -n "${dir}" ] && prefix="${prefix}${dir}:"
    done <<< "$(bashio::config 'additional_path')"
fi
readonly EFFECTIVE_PATH="${prefix}${STANDARD_PATH}"

# 両ファイルを初期化しつつ PATH を書き出す
printf '# generated by init-env (SCS Forge) — 編集は HA 構成タブで\nPATH="%s"\n' \
    "${EFFECTIVE_PATH}" > "${ENV_FILE}"
{
    printf '# generated by init-env (SCS Forge) — 編集は HA 構成タブで\n'
    printf 'export PATH=%q\n' "${EFFECTIVE_PATH}"
} > "${SH_FILE}"

# env_vars を両ファイルへ
if bashio::config.has_value 'env_vars'; then
    count=$(bashio::config 'env_vars | length')
    for (( i=0; i<count; i++ )); do
        name=$(bashio::config "env_vars[${i}].name")
        value=$(bashio::config "env_vars[${i}].value")
        [ -z "${name}" ] && continue
        # 統合ターミナル用: %q でシェル安全にクォート
        printf 'export %s=%q\n' "${name}" "${value}" >> "${SH_FILE}"
        # SSH用 /etc/environment（pam_env）。'$' 混入は誤解釈しうるのでスキップ＋警告
        if printf '%s' "${value}" | grep -q '[$]'; then
            bashio::log.warning "env '${name}' は '\$' を含むため /etc/environment ではスキップ（SSHセッションのみ未反映・統合ターミナルには反映済み）"
        else
            printf '%s="%s"\n' "${name}" "${value//\"/\\\"}" >> "${ENV_FILE}"
        fi
    done
fi

bashio::log.info "init-env: PATH=${EFFECTIVE_PATH} ＋ env_vars を /etc/environment・/etc/scs-env.sh に反映"
