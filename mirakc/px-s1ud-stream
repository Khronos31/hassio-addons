#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Compatibility for existing config.yml commands; new tuners call siano-ts directly.
set -eu

if [ "$#" -ne 1 ]; then
    echo "Usage: px-s1ud-stream CHANNEL" >&2
    exit 2
fi
settle=${PX_S1UD_SETTLE_SECONDS:-0}
if [ "$settle" != 0 ]; then
    sleep "$settle"
fi
# The driver validates terrestrial channel syntax.
exec "${SIANO_TS_BIN:-/usr/local/bin/siano-ts}" \
    --channel "$1" \
    --device "${PX_S1UD_ADAPTER:-0}" \
    --firmware "${PX_S1UD_FIRMWARE:-/lib/firmware/isdbt_rio.inp}"
