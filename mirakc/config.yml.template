# 同梱ドライバのチューナーは、接続中の筐体・受信機から起動時に自動生成します。
# 独自ドライバや手動設定を使う場合は、ここにチューナー定義を追加してください。
tuners: []


# チューナー出力は生TS。復号はジョブ（EPGスキャン）には掛けない。
filters:
  decode-filter:
    command: /usr/bin/recisdb decode --input - -
