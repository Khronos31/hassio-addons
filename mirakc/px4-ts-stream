#!/bin/sh
# SPDX-License-Identifier: MIT
# Compatibility for existing config.yml commands; new tuners call px4-ts directly.
set -eu

if [ "$#" -ne 1 ]; then
    echo "Usage: px4-ts-stream CHANNEL" >&2
    exit 2
fi
channel=$1
if [ -n "${PX4_INSTANCE:-}" ]; then
    set -- --instance "$PX4_INSTANCE"
elif [ -n "${PX4_DEVICE:-}" ]; then
    set -- --device "$PX4_DEVICE"
else
    echo "PX4_INSTANCE or PX4_DEVICE is required" >&2
    exit 2
fi
: "${PX4_RECEIVER:?PX4_RECEIVER is required}"
# The driver validates channel syntax and receiver capabilities.
exec "${PX4_TS_BIN:-/usr/local/bin/px4-ts}" "$@" \
    --receiver "$PX4_RECEIVER" \
    --channel "$channel" \
    --runtime-dir "${PX4_RUNTIME_DIR:-/run/px4-userland}" \
    --output -
