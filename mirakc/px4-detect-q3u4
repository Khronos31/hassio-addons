#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

LC_ALL=C
export LC_ALL

sysfs_root=${PX4_SYSFS_ROOT:-/sys/bus/usb/devices}
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/px4-q3u4.XXXXXX")

cleanup()
{
    rm -rf "$tmp_dir" || :
}

cleanup_on_exit()
{
    status=$?
    trap - EXIT HUP INT TERM
    cleanup
    exit "$status"
}

cleanup_on_signal()
{
    trap - EXIT HUP INT TERM
    cleanup
    exit 1
}

trap cleanup_on_exit EXIT
trap cleanup_on_signal HUP INT TERM

records=$tmp_dir/records
: > "$records"
target_count=0

for device_path in "$sysfs_root"/*; do
    [ -d "$device_path" ] || continue
    [ -r "$device_path/idVendor" ] || continue
    [ -r "$device_path/idProduct" ] || continue

    vendor=$(cat "$device_path/idVendor")
    product=$(cat "$device_path/idProduct")
    [ "$vendor" = 0511 ] || continue
    [ "$product" = 084a ] || continue

    target_count=$((target_count + 1))
    if [ ! -r "$device_path/serial" ]; then
        echo "Q3U4 device has no readable serial: $device_path" >&2
        exit 1
    fi
    serial=$(cat "$device_path/serial")

    case $serial in
        [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
        *)
            echo "Invalid Q3U4 serial (expected 15 ASCII digits): $serial" >&2
            exit 1
            ;;
    esac

    base=${serial%?}
    suffix=${serial#??????????????}
    case $suffix in
        1|2) ;;
        *)
            echo "Invalid Q3U4 serial suffix (expected 1 or 2): $serial" >&2
            exit 1
            ;;
    esac
    printf '%s %s\n' "$base" "$suffix" >> "$records"
done

if [ "$target_count" -eq 0 ]; then
    echo "No Q3U4 USB devices found (VID:PID 0511:084a)" >&2
    exit 1
fi

pair_count=0
pair_base=
base_list=$tmp_dir/bases
awk '{print $1}' "$records" | sort -u > "$base_list"
while IFS= read -r base || [ -n "$base" ]; do
    suffix_1_count=$(awk -v wanted_base="$base" '$1 == wanted_base && $2 == "1" { count++ } END { print count + 0 }' "$records")
    suffix_2_count=$(awk -v wanted_base="$base" '$1 == wanted_base && $2 == "2" { count++ } END { print count + 0 }' "$records")

    if [ "$suffix_1_count" -gt 1 ] || [ "$suffix_2_count" -gt 1 ]; then
        echo "Duplicate Q3U4 serial suffix for base serial: $base" >&2
        exit 1
    fi
    if [ "$suffix_1_count" -eq 1 ] && [ "$suffix_2_count" -eq 1 ]; then
        pair_count=$((pair_count + 1))
        pair_base=$base
    elif [ "$suffix_1_count" -gt 0 ] || [ "$suffix_2_count" -gt 0 ]; then
        echo "Incomplete Q3U4 serial pair for base serial: $base" >&2
        exit 1
    fi
done < "$base_list"

case $pair_count in
    1)
        printf '%s\n' "$pair_base"
        ;;
    0)
        echo "Q3U4 devices do not form one complete serial pair" >&2
        exit 1
        ;;
    *)
        echo "Multiple complete Q3U4 serial pairs found: $pair_count" >&2
        exit 1
        ;;
esac
